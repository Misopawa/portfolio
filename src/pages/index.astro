---
import '../styles/global.css';
import PacmanBackground from '../components/PacmanBackground.astro';

const pageTitle = "Developer Portfolio | Mohamad Syahmi";
const name = "Mohamad Syahmi";
const profileImage = "/6275806174720496304.jpg"; 
const role = "System Administrator / Network Engineer / Technical Support Engineer";
const bio = "Network Computing graduate passionate about IT infrastructure, network security, and cloud monitoring. Experienced in proactive system administration and performance optimization. Driven to build and support reliable, low-latency IT operations.";

// --- DATA SECTIONS ---
const projects = [
  {
    title: "AI-Powered Cloud Monitoring & Auto-Healing System",
    description: "An intelligent, hybrid cloud server monitoring and remediation system that combines traditional time-series monitoring with unsupervised machine learning. Built to align with Industry 4.0 principles, this system detects abnormal server behavior, reduces downtime, and automatically triggers native hypervisor recovery actions without human intervention.",
    tags: ["Python", "Isolation Forest", "Prometheus", "Grafana", "Docker"],
	status: "Ongoing",
	category: "Final Year Project",
	link: "https://github.com/Misopawa/Pyhon-Script-for-Cloud-Monitoring"
  },
];

function getStatusBadgeClass(status) {
  if (status === 'Completed') {
    return 'bg-green-950/60 text-green-400 border-green-800/50';
  }
  return 'bg-yellow-950/60 text-yellow-400 border-yellow-800/50';
}

function getCategoryIcon(category) {
  switch (category) {
    case 'Final Year Project':
      return '🎓 Final Year Project';
    case 'Client Work':
      return '💼 Client';
    case 'Personal':
      return '💻 Personal Project';
    default:
      return `📁 ${category}`;
  }
}

const education = [
{
	degree: "Pre-University Matriculation (Physical Science)",
	institution: "Labuan Matriculation College (KML)",
	period: "2020 - 2022"
}, 
{
    degree: "Bachelor of Computer Science (Network Computing)",
    institution: "Universiti Malaysia Sarawak (UNIMAS)",
    period: "2022 - 2026",
}
];

const experience = [
{
    role: "Fuel Attendant (Part-Time)",
    company: "SHELL Gas Station",
    period: "August 2023 - September 2023",
    details: "Learning the basics of customer service, cash handling, and fuel station operations. Gained experience in managing transactions, assisting customers, and maintaining a safe and efficient work environment."
},
{
	role: "Promoter (Part-Time)",
	company: "OOPSSTUDIO",
	period: "September 2023 - September 2023",
	details: "Promoted and marketed products to customers, enhancing brand visibility and driving sales. Developed communication and interpersonal skills while engaging with diverse customer groups."
},
{
	role: "Electrical Technician Assistant (Part-Time)",
	company: "RICHMI Enterprise",
	period: "October 2023 - Present",
	details: "Assisting in electrical installations, maintenance, and troubleshooting. Gained hands-on experience in electrical systems, wiring, and safety protocols while supporting senior technicians in various projects."
},
{
	role: "Web Developer (Internship)",
	company: "Sumpit Kelangit SDN. BHD.",
	period: "March 2025 - August 2025",
	details: "Developing and maintaining web applications, ensuring responsive design and user-friendly interfaces. Collaborating with clients to understand requirements and deliver effective web solutions."
},
{
	role: "IT Support Specialist (Freelance)",
	company: "Personal",
	period: "Present",
	details: "Providing technical support and troubleshooting for clients, including hardware and software issues. Offering solutions to optimize system performance and ensure smooth IT operations."
}
];

const certificates = [
  
];

const contact = {
  phone: "+60123456789",       // Replace with your actual phone number with country code
  whatsapp: "60123456789",     // Phone number without the '+' sign for WhatsApp API link
  email: "mohamadsyahmi020204@gmail.com"  // Replace with your Gmail address
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>

	<link rel="preconnect" href="https://fonts.googleapis.com">
  	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  	<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
  </head>
  
  <body class="bg-slate-950 text-slate-100 font-sans min-h-screen antialiased">
  
  <!-- RETRO PAC-MAN BACKGROUND LAYER -->
  <PacmanBackground />

  <main class="relative z-10 max-w-3xl mx-auto px-6 pt-4 pb-16" x-data="{ activeTab: 'projects' }">
    <!-- Rest of your portfolio content... -->
  </main>

    
    <main class="max-w-3xl mx-auto px-6 py-16" x-data="{ activeTab: 'projects' }">
      
      <!-- HERO SECTION -->
      <header class="flex flex-col items-center text-center mb-12">
        
        <!-- *** PASTE HERE: ARCADE STATUS BADGE *** -->
        <div class="flex justify-center w-full mb-4">
          <span class="font-pixel text-[10px] uppercase tracking-widest text-emerald-400 bg-emerald-950/80 border-2 border-emerald-500 px-3 py-1.5 shadow-[2px_2px_0px_#000]">
            🎮 Portfolio 🎮
          </span>
        </div>

        <!-- ANIMATED RETRO TITLE -->
		<h1 
		x-data="{ 
			fullText: 'HI, I\'M MOHAMAD SYAHMI', 
			displayText: '', 
			index: 0,
			init() {
			let timer = setInterval(() => {
				if (this.index < this.fullText.length) {
				this.displayText += this.fullText.charAt(this.index);
				this.index++;
				} else {
				clearInterval(timer);
				}
			}, 90); // Speed in milliseconds per letter (90ms feels like classic RPG text)
			}
		}"
		class="font-pixel text-2xl sm:text-3xl font-bold tracking-tight text-white mt-2 mb-6 text-sky-400 drop-shadow-[2px_2px_0px_rgba(0,0,0,1)] min-h-[2.5rem] flex items-center justify-center gap-1"
		>
		<!-- Display typed text -->
		<span x-text="displayText"></span>
		
		<!-- Blinking Arcade Cursor Block -->
		<span class="inline-block w-3 h-6 bg-emerald-400 animate-pulse border border-emerald-300"></span>
		</h1>

        <!-- CIRCLE PROFILE IMAGE (Sits right under your name) -->
		<div class="relative w-60 h-60 mb-5 group">
			<div class="absolute -inset-1 rounded-full bg-emerald-500/40 blur-md group-hover:bg-purple-500/60 transition duration-300"></div>
			<div class="relative w-full h-full rounded-full border-4 border-emerald-400 bg-slate-900 p-1 shadow-[0_0_15px_rgba(52,211,153,0.5)]">
				<img 
				src={profileImage}
				alt={`${name}'s Profile`}
				class="w-full h-full rounded-full object-cover"
				/>
			</div>
			</div>

        <!-- Role & Bio -->
        <p class="font-arcade text-2xl text-sky-400 font-medium mb-4">{role}</p>
        <p class="text-slate-400 leading-relaxed text-base sm:text-lg max-w-2xl">{bio}</p>
      </header>

      <!-- TAB BUTTONS NAV -->
      <nav class="flex flex-wrap justify-center gap-2 mb-10 border-b border-slate-800 pb-6">
        <button 
          @click="activeTab = 'projects'"
          :class="activeTab === 'projects' ? 'bg-sky-500/10 text-sky-400 border-sky-500' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200'"
          class="px-4 py-2 text-sm font-medium border rounded-xl transition duration-150 cursor-pointer">
          🚀 Projects
        </button>

        <button 
          @click="activeTab = 'experience'"
          :class="activeTab === 'experience' ? 'bg-sky-500/10 text-sky-400 border-sky-500' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200'"
          class="px-4 py-2 text-sm font-medium border rounded-xl transition duration-150 cursor-pointer">
          💼 Experience
        </button>

        <button 
          @click="activeTab = 'education'"
          :class="activeTab === 'education' ? 'bg-sky-500/10 text-sky-400 border-sky-500' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200'"
          class="px-4 py-2 text-sm font-medium border rounded-xl transition duration-150 cursor-pointer">
          🎓 Education
        </button>

        <button 
          @click="activeTab = 'certificates'"
          :class="activeTab === 'certificates' ? 'bg-sky-500/10 text-sky-400 border-sky-500' : 'bg-slate-900 text-slate-400 border-slate-800 hover:text-slate-200'"
          class="px-4 py-2 text-sm font-medium border rounded-xl transition duration-150 cursor-pointer">
          📜 Certificates
        </button>
      </nav>

      <!-- TAB CONTENT AREA -->
      <section>

        <!-- 1. PROJECTS TAB -->
		<div x-show="activeTab === 'projects'" class="space-y-6">
		{projects.map((project) => (
			<div class="group bg-slate-900/60 border border-slate-800 hover:border-sky-500/50 rounded-2xl p-6 transition-all duration-200">
			
			<!-- Header: Clickable Title & Badges -->
			<div class="flex justify-between items-start flex-wrap gap-3 mb-3">
				
				<!-- CLICKABLE TITLE -->
				<h3 class="text-xl font-semibold text-slate-100 group-hover:text-sky-400 transition-colors">
				{project.link ? (
					<a 
					href={project.link} 
					target="_blank" 
					rel="noopener noreferrer" 
					class="inline-flex items-center gap-1.5 hover:underline"
					>
					{project.title}
					<!-- External Link Icon -->
					<svg class="w-4 h-4 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
					</svg>
					</a>
				) : (
					project.title
				)}
				</h3>
				
				<!-- Badges Container -->
				<div class="flex items-center gap-2 flex-wrap">
				<span class="text-xs font-mono px-2.5 py-1 rounded-full border bg-slate-800/90 text-slate-300 border-slate-700">
					{getCategoryIcon(project.category)}
				</span>
				<span class={`text-xs font-mono px-2.5 py-1 rounded-full border ${getStatusBadgeClass(project.status)}`}>
					{project.status === 'Ongoing' ? '⏳ Ongoing' : '✅ Completed'}
				</span>
				</div>
			</div>

			<p class="text-slate-400 text-sm sm:text-base leading-relaxed mt-2 mb-4">
				{project.description}
			</p>

			<!-- Bottom Bar: Tags & View Link -->
			<div class="flex justify-between items-center flex-wrap gap-4 pt-2">
				<div class="flex flex-wrap gap-2">
				{project.tags.map((tag) => (
					<span class="bg-slate-800/80 border border-slate-700/50 text-sky-300 font-mono text-xs px-2.5 py-1 rounded-md">
					{tag}
					</span>
				))}
				</div>

				{project.link && (
				<a 
					href={project.link} 
					target="_blank" 
					rel="noopener noreferrer" 
					class="text-xs font-mono text-sky-400 hover:text-sky-300 flex items-center gap-1 font-medium transition-colors"
				>
					View Repository &rarr;
				</a>
				)}
			</div>

			</div>
		))}
		</div>

        <!-- 2. WORKING EXPERIENCE TAB -->
        <div x-show="activeTab === 'experience'" class="space-y-6" x-cloak>
          {experience.map((exp) => (
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6">
              <div class="flex justify-between items-start flex-wrap gap-2 mb-2">
                <h3 class="text-xl font-semibold text-slate-100">{exp.role}</h3>
                <span class="text-xs font-mono text-sky-400 bg-sky-950/60 border border-sky-800/50 px-2.5 py-1 rounded-md">
                  {exp.period}
                </span>
              </div>
              <p class="text-sky-400 text-sm font-medium mb-3">{exp.company}</p>
              <p class="text-slate-400 text-sm sm:text-base leading-relaxed">{exp.details}</p>
            </div>
          ))}
        </div>

        <!-- 3. EDUCATION TAB -->
        <div x-show="activeTab === 'education'" class="space-y-6" x-cloak>
          {education.map((edu) => (
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6">
              <div class="flex justify-between items-start flex-wrap gap-2 mb-2">
                <h3 class="text-xl font-semibold text-slate-100">{edu.degree}</h3>
                <span class="text-xs font-mono text-sky-400 bg-sky-950/60 border border-sky-800/50 px-2.5 py-1 rounded-md">
                  {edu.period}
                </span>
              </div>
              <p class="text-sky-400 text-sm font-medium mb-3">{edu.institution}</p>
              <p class="text-slate-400 text-sm sm:text-base leading-relaxed">{edu.details}</p>
            </div>
          ))}
        </div>

        <!-- 4. CERTIFICATES & ACHIEVEMENTS TAB -->
        <div x-show="activeTab === 'certificates'" class="space-y-6" x-cloak>
          {certificates.map((cert) => (
            <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 flex justify-between items-center flex-wrap gap-4">
              <div>
                <h3 class="text-lg font-semibold text-slate-100">{cert.title}</h3>
                <p class="text-slate-400 text-sm mt-1">{cert.issuer}</p>
              </div>
              <span class="text-xs font-mono text-sky-400 bg-sky-950/60 border border-sky-800/50 px-3 py-1 rounded-md">
                {cert.year}
              </span>
            </div>
          ))}
        </div>

      </section>
	<!-- CONTACT SECTION -->
      <footer class="mt-20 border-t border-slate-800 pt-10 pb-8 text-center">
        <h2 class="text-2xl font-bold text-slate-100 mb-2">Get In Touch</h2>
        <p class="text-slate-400 text-sm max-w-md mx-auto mb-8">
          Whether you have a question, a project proposal, or just want to say hi, feel free to reach out!
        </p>

        <!-- CONTACT BUTTONS GRID -->
        <div class="flex flex-wrap justify-center gap-4">
          
          <!-- EMAIL (GMAIL) BUTTON -->
          <a 
            href={`mailto:${contact.email}`}
            class="flex items-center gap-2 bg-slate-900 border border-slate-800 hover:border-sky-500 text-slate-200 hover:text-sky-400 px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 group"
          >
            <!-- Gmail / Email Icon -->
            <svg class="w-5 h-5 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            
          </a>

          <!-- WHATSAPP BUTTON -->
          <a 
            href={`https://wa.me/${contact.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 bg-slate-900 border border-slate-800 hover:border-emerald-500 text-slate-200 hover:text-emerald-400 px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 group"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-5 h-5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            
          </a>

          <!-- PHONE CALL BUTTON -->
          <a 
            href={`tel:${contact.phone}`}
            class="flex items-center gap-2 bg-slate-900 border border-slate-800 hover:border-amber-500 text-slate-200 hover:text-amber-400 px-4 py-2.5 rounded-xl font-medium text-sm transition-all duration-200 group"
          >
            <!-- Phone Icon -->
            <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            
          </a>

        </div>

        <p class="text-xs text-slate-600 mt-12 font-mono">
          &copy; {new Date().getFullYear()} Mohamad Syahmi. All rights reserved.
        </p>
      </footer>
    </main>

  </body>
</html>